# tg115bot 配置模板 —— 复制为 config.yaml 后填写
# 环境变量可覆盖同名键：TG115BOT__TELEGRAM__BOT_TOKEN 等（双下划线分层）

telegram:
  api_id: 1234567                 # https://my.telegram.org 申请
  api_hash: "your_api_hash"
  bot_token: "123456:ABC-YOURTOKEN"   # @BotFather
  # 可选：user session 用于下载 >20MB 视频 / 提升额度。留空则只用 bot（≤20MB）。
  # 生成方式：python scripts/make_session.py
  user_session: ""                # 形如 config/user.session 或 session 字符串
  allowed_users: []               # TG user_id 白名单；空 [] = 不限制
  # 国内服务器访问 TG 必需（115/OSS 不走代理，国内直连更快）
  # 形如 "socks5://127.0.0.1:7891" 或 "http://127.0.0.1:7890"；留空 = 直连
  proxy: "http://127.0.0.1:7890"

upload:
  workers: 8                      # TG 并行下载分片数（>1 启用并行分片下载）
  chunk_size: 1048576             # 下载分片大小（字节），默认 1MB
  oss_concurrency: 8              # OSS 分片并发数
  target_dir: "/tg115bot"         # 115 默认目标目录（不存在自动创建）
  delete_after_upload: true       # 上传成功后删除本地临时文件

queue:
  concurrency: 2                  # 同时处理的任务数；多任务并发注意带宽/磁盘

# 115 账号（开放平台扫码授权；支持多条轮转）
# 首次使用：启动后发 /auth，bot 会发 115 扫码二维码，扫码即完成授权。
# token 自动持久化到 config/open_token_<账号名>.json（可用 TG115BOT_SECRET_KEY 加密）。
accounts:
  - name: "main"
    app_id: ""                    # 留空用内置公共测试 AppID；有自己开放平台应用的填这里
    weight: 1                     # 多账号轮转权重

storage:
  work_dir: "downloads"           # 临时下载目录
  min_free_gb: 5                  # 可用空间下限（GB），低于则暂停接新任务

# 115 风控退避
115_rate:
  min_interval_sec: 0.3           # 请求最小间隔
  backoff_base_sec: 2             # 指数退避基数
  max_retries: 5

# Phase 3 起
web:
  enable: false
  host: "0.0.0.0"
  port: 8080
  username: "admin"
  password: "changeme"

organize:
  rename_template: "{filename}"    # 可用变量: {filename} {name} {ext} {date} {time} {datetime} {size}
  classify_by_ext: false           # true 时按扩展名归入 子目录(视频/音频/图片/文档/压缩包/其他)

# ── Phase 3：频道监控 ──────────────────────────────────────────────────────
# bot 需以成员/管理员身份加入目标频道；规则可在 Web 台或 /channels 命令管理
channel_monitor:
  enabled: false
  default_target_dir: ""           # 命中规则但规则未指定目录时的兜底；空=用 upload.target_dir
  notify_chat_id: 0                # 进度/结果通知发往此 chat_id；0=回复到频道（需频道管理员权限）

# ── Phase 4：日志与凭据加密 ────────────────────────────────────────────────
logging:
  level: "INFO"                    # DEBUG/INFO/WARNING/ERROR
  file: "logs/tg115bot.log"
  max_bytes: 10485760              # 10MB 轮转
  backup_count: 5
  db_buffer: 200                   # >0 时把日志缓冲落盘到 SQLite（Web 台可查）

security:
  secret_key: ""                   # 留空则读环境变量 TG115BOT_SECRET_KEY；仍空用开发态默认（仅本机）

# ── 电影订阅（可选；需 nullbr API 授权）────────────────────────────────────
# 申请: https://nullbr.online/api
movie_sub:
  app_id: ""
  api_key: ""
  target_dir: "/tg115bot/movies"
  zh_sub_only: false             # true 时只选带中字的资源
