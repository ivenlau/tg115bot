# tg115bot 环境变量示例 -- 复制为 .env 后填写（docker compose 自动加载）
# 任意 config.yaml 键都可用 TG115BOT__段__键 覆盖（双下划线分层）

# ── Telegram ────────────────────────────────────────────────────────────────
TG115BOT__TELEGRAM__API_ID=1234567
TG115BOT__TELEGRAM__API_HASH=your_api_hash
TG115BOT__TELEGRAM__BOT_TOKEN=123:ABC-YOURTOKEN

# TG 代理（国内服务器必需；115/OSS 不走代理，国内直连更快）
# ⚠️ 容器内 127.0.0.1 指向容器自身，必须写宿主机地址；
#    compose 已配 extra_hosts，host.docker.internal 在 Linux 上也可用：
#TG115BOT__TELEGRAM__PROXY=http://host.docker.internal:7890

# ── 115 授权 ────────────────────────────────────────────────────────────────
# 开放平台扫码授权：启动后发 /auth（或跑 python scripts/check115.py --auth），
# 扫码后 token 自动落盘 config/open_token_<账号名>.json，无需在此填任何东西。
# 有自己开放平台应用才需要 AppID：
#TG115BOT__ACCOUNTS__0__APP_ID=100195125

# ── Web 管理台 ───────────────────────────────────────────────────────────────
TG115BOT__WEB__ENABLE=true
TG115BOT__WEB__USERNAME=admin
TG115BOT__WEB__PASSWORD=changeme

# ── 凭据加密口令（强烈建议生产环境设置；加密落盘 115 token）──────────────────
TG115BOT_SECRET_KEY=******-******-****-**-*-****-******-******-******

# ── 分享链接转存（可选；浏览器登录 115 后复制 Cookie）────────────────────────
#TG115BOT__SHARE__COOKIES=

# ── AI 助手（可选；api_key 与 model 均非空才启用，OpenAI 兼容协议）───────────
#TG115BOT__AI__BASE_URL=https://api.deepseek.com/v1
#TG115BOT__AI__API_KEY=
#TG115BOT__AI__MODEL=deepseek-chat
